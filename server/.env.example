# =================================================================
# Google Cloud SQL Database Configuration
# =================================================================
# Choose your Cloud SQL database engine: postgres | mysql
DB_TYPE=postgres

# Google Cloud SQL Instance Connection Name (Optional if connecting via IP/Host)
# Format: project-id:region:instance-id
CLOUD_SQL_CONNECTION_NAME=

# Database Host (e.g. 127.0.0.1 if using Cloud SQL Auth Proxy, or your Cloud SQL Public/Private IP)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=skillgrad

# API Server Port
PORT=5000
